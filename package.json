{
  "name": "pancode",
  "version": "2.3.0",
  "description": "基于 Monaco Editor (VS Code 开源内核) 的 Web AI 编程工作台 — 可写编辑器 + Git 基线 + 真实 LLM Agent 工具调用循环（OpenAI 兼容），无 Key 时演示引擎保底",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis",
    "smoke": "node scripts/smoke-test.js",
    "test:fileops": "node scripts/fileops-test.js",
    "test:verify": "node scripts/_verify_render.js && node scripts/_verify_repo_map.js && node scripts/_verify_tools.js && node scripts/_verify_agentflow.js",
    "test:integration": "node scripts/integration-runner.js",
    "test:lsp": "node scripts/test-lsp.js",
    "test:code-index": "node scripts/test-code-index.js",
    "test:patch": "node scripts/test-patch.js",
    "verify:ui": "node scripts/verify-ui.js",
    "index:build": "node scripts/index-build.js",
    "verify:search": "node scripts/verify-search.js",
    "test": "npm run test:verify && node scripts/smoke-test.js && node scripts/fileops-test.js && npm run test:integration && npm run test:patch && npm run test:lsp && npm run test:code-index"
  },
  "build": {
    "appId": "com.pancode.app",
    "productName": "pancode",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "workspace/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mammoth": "^1.12.0",
    "ws": "^8.17.0"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "40.9.3",
    "electron-builder": "^26.0.12",
    "playwright": "^1.62.1"
  }
}
