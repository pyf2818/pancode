{
  "name": "pancode",
  "version": "3.7.3",
  "description": "本地优先的 AI 编程工作台 —— Monaco 可写编辑器 + 集成终端 + 真实 LLM Agent 工具循环（OpenAI 兼容 / Anthropic 原生），无 Key 时演示引擎保底",
  "keywords": [
    "ai",
    "coding-agent",
    "llm",
    "monaco-editor",
    "electron",
    "developer-tools",
    "react",
    "mcp",
    "local-first"
  ],
  "license": "MIT",
  "author": "pyf2818",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyf2818/pancode.git"
  },
  "bugs": {
    "url": "https://github.com/pyf2818/pancode/issues"
  },
  "homepage": "https://github.com/pyf2818/pancode#readme",
  "main": "electron/main.js",
  "bin": {
    "pancode": "cli/cli.js"
  },
  "scripts": {
    "cli": "node cli/cli.js",
    "start": "node server/index.js",
    "start:bg": "node _start.js",
    "dev": "node server/index.js",
    "desktop": "electron .",
    "dist": "node scripts/dist.js",
    "smoke": "node scripts/smoke-test.js",
    "test:fileops": "node scripts/fileops-test.js",
    "test:verify": "node scripts/verify-layers.js",
    "verify:contract": "node scripts/verify-layers.js --layer=1",
    "verify:integration": "node scripts/verify-layers.js --layer=2",
    "verify:browser": "node scripts/verify-layers.js --layer=3",
    "verify:release": "node scripts/verify-layers.js --layer=2,3,4",
    "verify:model": "node scripts/verify-layers.js --layer=5",
    "test:integration": "node scripts/integration-runner.js",
    "test:lsp": "node scripts/test-lsp.js",
    "test:code-index": "node scripts/test-code-index.js",
    "test:summary": "node scripts/test-change-summary.js",
    "test:patch": "node scripts/test-patch.js",
    "verify:ui": "node scripts/verify-ui.js",
    "verify:pkg": "node scripts/_verify_pkg.js",
    "verify:workflow-ui": "node scripts/_verify_workflow_ui.js",
    "verify:all": "node scripts/test-change-summary.js && node scripts/verify-layers.js --layer=all",
    "index:build": "node scripts/index-build.js",
    "verify:search": "node scripts/verify-search.js",
    "test:vitest": "vitest run",
    "test:nightly": "node scripts/nightly-real-llm.js",
    "test:unit": "node scripts/_verify_dataroot.js mark && vitest run && node scripts/_verify_dataroot.js check",
    "lint": "npx eslint server/ test/ public/ scripts/ cli/ electron/ contracts/ --quiet",
    "lint:strict": "npx eslint contracts/ server/permission-core.js server/auth.js server/safe-write.js server/preview-sanitize.js server/ws-safe.js --max-warnings=0",
    "lint:fix": "npx eslint server/ test/ public/ scripts/ cli/ electron/ contracts/ --quiet --fix",
    "format": "npx prettier --write \"server/**/*.js\" \"test/**/*.js\" \"public/**/*.js\"",
    "test": "npm run test:unit && npm run test:verify && node scripts/smoke-test.js && node scripts/fileops-test.js && npm run test:integration && npm run test:patch && npm run test:lsp && npm run test:code-index"
  },
  "build": {
    "appId": "com.pancode.app",
    "productName": "pancode",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "workspace/**",
      "assets/**",
      "package.json",
      "!node_modules/agent-browser/bin/agent-browser-darwin-*",
      "!node_modules/agent-browser/bin/agent-browser-linux*"
    ],
    "asarUnpack": [
      "node_modules/agent-browser/bin/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "agent-browser": "0.39.1",
    "cli-highlight": "^2.1.11",
    "express": "^4.19.2",
    "highlight.js": "^11.10.0",
    "mammoth": "^1.12.0",
    "marked": "^14.0.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "electron": "40.9.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.3.0",
    "vitest": "^5.0.0"
  }
}
